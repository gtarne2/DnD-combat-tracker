<?xml version="1.0" encoding="utf-8"?>
<elements>
  <info>
    <update version="1.0" />
  </info>
  <element id="ID_TEST_SPELL_BEACON" name="Beacon" type="Spell" source="Synthetic Base">
    <setters><set name="range">30 feet</set></setters>
  </element>
  <element id="ID_TEST_SPELL_BEACON_OTHER_EDITION" name="Beacon" type="Spell" source="Other Edition">
    <setters><set name="range">300 feet</set></setters>
  </element>
  <element id="ID_TEST_SPELL_SPARK" name="Spark" type="Spell" source="Synthetic Base">
    <setters><set name="level">0</set></setters>
  </element>
  <element id="ID_TEST_ITEM_ROD" name="Signal Rod" type="Magic Item" source="Synthetic Base">
    <sheet usage="3/Day"><description>Send a short signal.</description></sheet>
    <rules><stat name="signal rod:charges" value="3" /></rules>
  </element>
  <element id="ID_TEST_CLASS_TINKERER" name="Tinkerer" type="Multiclass" source="Synthetic Base">
    <rules><grant type="Class Feature" id="ID_TEST_FEATURE_TURRET" level="3" /></rules>
  </element>
  <element id="ID_TEST_FEATURE_TURRET" name="Signal Turret" type="Class Feature" source="Synthetic Base">
    <description><p>Choose one turret mode.</p></description>
    <rules>
      <grant type="Class Feature" id="ID_TEST_TURRET_BALLISTA" />
      <grant type="Class Feature" id="ID_TEST_TURRET_FLAME" />
      <grant type="Class Feature" id="ID_TEST_TURRET_PROTECTOR" level="3" />
      <select type="Companion" name="Workshop assistant" supports="Workshop" />
    </rules>
  </element>
  <element id="ID_TEST_TURRET_BALLISTA" name="Ballista Mode" type="Class Feature" source="Synthetic Base">
    <sheet action="Bonus Action"><description>Fire a signal bolt.</description></sheet>
    <rules><stat name="turret:ballista:dice" value="2" /></rules>
  </element>
  <element id="ID_TEST_TURRET_FLAME" name="Flame Mode" type="Class Feature" source="Synthetic Base">
    <sheet action="Bonus Action"><description>Project a short burst.</description></sheet>
    <rules><stat name="turret:flame:range" value="15" /></rules>
  </element>
  <element id="ID_TEST_TURRET_PROTECTOR" name="Protector Mode" type="Class Feature" source="Synthetic Base">
    <description><div element="ID_TEST_FEATURE_TURRET" /></description>
    <rules><stat name="turret:protector:dice" value="1" /></rules>
  </element>
</elements>
